# AeroSpace config — https://nikitabobko.github.io/AeroSpace/guide
# Starter config: i3-style defaults, trimmed down from the bundled default.

config-version = 2

start-at-login = true

# Reload automatically when this file is saved.
# (Already active — if you ever edit before AeroSpace is running, reload once
# manually with `aerospace reload-config`.)
auto-reload-config = true

after-startup-command = []

# Normalizations keep the layout tree tidy. Leave these on until you have a
# reason not to. See guide#normalization
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# tiles|accordion
default-root-container-layout = 'tiles'
# horizontal|vertical|auto ('auto' = wide monitor gets horizontal)
default-root-container-orientation = 'auto'

# Size of the accordion peek when using accordion layout
accordion-padding = 30

# Warp the mouse to the newly focused monitor so it doesn't get lost
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

# Set to true if you want focus to track the pointer
focus-follows-mouse.enabled = false

automatically-unhide-macos-hidden-apps = false

key-mapping.preset = 'qwerty'

# Small gaps so tile edges are visible. Set all to 0 for edge-to-edge.
gaps.inner.horizontal = 8
gaps.inner.vertical   = 8
gaps.outer.left       = 8
gaps.outer.bottom     = 8
gaps.outer.top        = 8
gaps.outer.right      = 8

# Keep workspaces 1-9 alive even when empty, so they don't vanish from the
# menubar / `aerospace list-workspaces` when you leave them.
persistent-workspaces = ["1", "2", "3", "4", "5", "6", "7", "8", "9"]

on-mode-changed = []

# ─── main mode ────────────────────────────────────────────────────────────────
# Modifiers: cmd, alt, ctrl, shift.  Full command list: guide + /commands
[mode.main.binding]

    # Launch a terminal (i3's alt-enter)
    alt-enter = '''exec-and-forget osascript -e 'tell application "Terminal" to do script ""' -e 'tell application "Terminal" to activate' '''

    # Layout switching
    alt-slash = 'layout tiles horizontal vertical'   # toggle split direction
    alt-comma = 'layout accordion horizontal vertical'
    alt-f     = 'fullscreen'
    alt-shift-space = 'layout floating tiling'       # float / unfloat window

    # Focus (vim keys)
    alt-h = 'focus left'
    alt-j = 'focus down'
    alt-k = 'focus up'
    alt-l = 'focus right'

    # Move the focused window
    alt-shift-h = 'move left'
    alt-shift-j = 'move down'
    alt-shift-k = 'move up'
    alt-shift-l = 'move right'

    # Resize
    alt-minus = 'resize smart -50'
    alt-equal = 'resize smart +50'
    # Make ALL windows on screen truly equal size.
    # Flattens any nesting first, so N windows each get exactly 1/N of the
    # screen. This is the one you want most of the time.
    alt-b = ['flatten-workspace-tree', 'balance-sizes']
    # Balance within the existing tree structure, preserving nesting/grouping.
    alt-shift-b = 'balance-sizes'

    # Switch workspace
    alt-1 = 'workspace 1'
    alt-2 = 'workspace 2'
    alt-3 = 'workspace 3'
    alt-4 = 'workspace 4'
    alt-5 = 'workspace 5'
    alt-6 = 'workspace 6'
    alt-7 = 'workspace 7'
    alt-8 = 'workspace 8'
    alt-9 = 'workspace 9'

    # Send focused window to a workspace
    alt-shift-1 = 'move-node-to-workspace 1'
    alt-shift-2 = 'move-node-to-workspace 2'
    alt-shift-3 = 'move-node-to-workspace 3'
    alt-shift-4 = 'move-node-to-workspace 4'
    alt-shift-5 = 'move-node-to-workspace 5'
    alt-shift-6 = 'move-node-to-workspace 6'
    alt-shift-7 = 'move-node-to-workspace 7'
    alt-shift-8 = 'move-node-to-workspace 8'
    alt-shift-9 = 'move-node-to-workspace 9'

    # Jump back to the previous workspace
    alt-tab = 'workspace-back-and-forth'
    # Throw the current workspace onto the next monitor
    alt-shift-tab = 'move-workspace-to-monitor --wrap-around next'

    # Enter service mode
    alt-shift-semicolon = 'mode service'

# ─── service mode ─────────────────────────────────────────────────────────────
# Entered with alt-shift-; — each binding runs then drops back to main.
[mode.service.binding]
    esc       = ['reload-config', 'mode main']
    r         = ['flatten-workspace-tree', 'balance-sizes', 'mode main']  # reset layout + equalize
    b         = ['balance-sizes', 'mode main']               # equalize sizes only
    f         = ['layout floating tiling', 'mode main']
    backspace = ['close-all-windows-but-current', 'mode main']

    alt-shift-h = ['join-with left', 'mode main']
    alt-shift-j = ['join-with down', 'mode main']
    alt-shift-k = ['join-with up', 'mode main']
    alt-shift-l = ['join-with right', 'mode main']
